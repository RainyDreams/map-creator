# 蹭饭图生成器 · 镜像站 nginx 配置（cdn-beijing.linkbrain.top）
# 把本文件放到 /etc/nginx/conf.d/cdn-beijing.conf，改好证书路径后：
#   nginx -t && systemctl reload nginx

server {
    listen 443 ssl;
    server_name cdn-beijing.linkbrain.top;

    # SSL 证书（阿里云免费证书或 acme.sh 申请），路径按实际修改
    ssl_certificate     /etc/nginx/ssl/cdn-beijing.linkbrain.top.pem;
    ssl_certificate_key /etc/nginx/ssl/cdn-beijing.linkbrain.top.key;

    root /www/wwwroot/cdn-beijing;   # mirror-sync.sh 的 MIRROR_ROOT
    index index.html;

    # 关键：跨域许可。主站 https://map.linkbrain.top 会以跨域方式加载这里的 JS，
    # module script 与字体强制走 CORS，必须带这个头，否则浏览器拦截
    add_header Access-Control-Allow-Origin "https://map.linkbrain.top" always;

    # 带哈希的静态资源永久缓存（文件名变了就是新内容，不怕缓存）
    location /assets/ {
        add_header Access-Control-Allow-Origin "https://map.linkbrain.top" always;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    # 数据/字体/图片：短缓存即可（同步脚本每 5 分钟对账）
    location ~ ^/(data|fonts|images)/ {
        add_header Access-Control-Allow-Origin "https://map.linkbrain.top" always;
        add_header Cache-Control "public, max-age=300" always;
    }

    # HTML 不缓存，保证永远是最新入口
    location ~* \.html$ {
        add_header Access-Control-Allow-Origin "https://map.linkbrain.top" always;
        add_header Cache-Control "no-store" always;
    }

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1k;
}

# HTTP 强制跳 HTTPS
server {
    listen 80;
    server_name cdn-beijing.linkbrain.top;
    return 301 https://$host$request_uri;
}
